# Copy to .env and adjust. Never commit the real .env — it is gitignored.
#
# The values below match docker-compose.yml, so `docker compose up -d` plus these
# defaults is a working local setup.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/helpcar
DATABASE_USERNAME=helpcar
DATABASE_PASSWORD=helpcar
DATABASE_POOL_SIZE=10

# --- Redis (live location index + websocket fan-out) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
HELPCAR_VERSION=0.1.0-SNAPSHOT

# --- Matching engine tuning (see docs/ARCHITECTURE.md §6) ---
MATCHING_SEARCH_RADIUS_M=5000
MATCHING_MAX_DETOUR_M=3000
MATCHING_MAX_CANDIDATES=100

# --- Added in later PRs ---
# JWT_SECRET=
# ROUTING_ENGINE_URL=http://localhost:8989
# FCM_SERVICE_ACCOUNT_PATH=
