# --- Java ---
*.class
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# --- Packaged output ---
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# The Gradle wrapper jar is committed on purpose: it is what makes ./gradlew
# reproducible on a fresh clone and in CI. Keep this negation after *.jar.
!gradle/wrapper/gradle-wrapper.jar

# --- Gradle ---
.gradle/
build/

# --- Secrets / local config ---
# .env.example is committed; real .env files never are.
.env
.env.*
!.env.example
*.p12
*.pem
*-service-account.json

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
.classpath
.project
.settings/
nbproject/
.nb-gradle/

# --- OS ---
.DS_Store
Thumbs.db
